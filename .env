S3_ACCESS_KEY='your-s3-access-key'
S3_SECRET_KEY='your-s3-secret-key'
S3_REGION='us-east-1'
S3_SSL=False

MINIO_SYNC_BUCKET=""
MINIO_SYNC_PREFIX=""
MINIO_SYNC_INTERVAL_SECONDS="300"

CHANDRA_MODEL="/path/to/models--datalab-to--chandra-ocr-2"
