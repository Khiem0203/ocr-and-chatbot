CHUNK_SIZE="1000"
CHUNK_OVERLAP="150"

RETRIEVAL_TOP_K="10"
RERANK_TOP_N="5"
RERANK_MIN_SCORE="-5.0"
SUMMARY_MAX_PAGES="3"
SUMMARY_MAX_CHARS="9000"
SUMMARY_MAX_TOKENS="1024"
PRELOAD_MODELS="true"

AUTH_ENABLED="true"
API_USERNAME="your_username"
API_PASSWORD="your_password"
CORS_ORIGINS="*"

OCR_GPU_ID="0"
CHAT_GPU_ID="1"

CHAT_GPU_CONCURRENCY="1"
CHAT_HISTORY_TURNS="3"
CHAT_SESSION_TIMEOUT_MINUTES="90"
