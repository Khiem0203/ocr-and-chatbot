CHANDRA_MAX_TOKENS="2000"

SPELL_MODEL_PATH="yammdd/vietnamese-error-correction"

EMBEDDING_MODEL_PATH="/path/to/models--AITeamVN--Vietnamese_Embedding"
EMBEDDING_DIM="1024"
EMBEDDING_BATCH_SIZE="32"

RERANKER_MODEL_PATH="/path/to/models--AITeamVN--Vietnamese_Reranker"

RAG_LLM_MODEL="/path/to/models--AITeamVN--GRPO-VI-Qwen2-7B-RAG"
